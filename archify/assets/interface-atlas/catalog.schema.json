{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archify optional source interface atlas sidecar, v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "locale", "interfaces", "diagrams"],
  "properties": {
    "version": {"const": 1},
    "title": {"$ref": "#/$defs/text"},
    "locale": {"enum": ["en", "zh-CN"]},
    "context": {"type": "string"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "interfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interface"}},
    "diagrams": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/diagram"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000-\\u001f]+$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "startLine", "endLine"],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1},
        "label": {"$ref": "#/$defs/text"}
      }
    },
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "summary", "signature", "parameters", "returns"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"},
        "kind": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"},
        "signature": {"$ref": "#/$defs/text"}, "parameters": {"$ref": "#/$defs/strings"},
        "returns": {"$ref": "#/$defs/text"}, "callers": {"$ref": "#/$defs/strings"},
        "calls": {"$ref": "#/$defs/strings"}, "notes": {"$ref": "#/$defs/strings"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "signatureSource": {"$ref": "#/$defs/span"}
      }
    },
    "diagram": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "specification", "base", "delivery", "nodes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"},
        "specification": {"$ref": "#/$defs/path"}, "base": {"$ref": "#/$defs/path"},
        "delivery": {"$ref": "#/$defs/path"},
        "nodes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "interfaces"],
            "properties": {
              "id": {"$ref": "#/$defs/id"}, "note": {"type": "string"},
              "interfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
            }
          }
        }
      }
    }
  }
}
